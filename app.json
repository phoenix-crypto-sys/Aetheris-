{
  "expo": {
    "name": "Aetheris Mobile Demo",
    "slug": "aetheris-mobile-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aetheris.mesh",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Aetheris requires Bluetooth access to form an offline mesh network for disaster victims and emergency responders.",
        "NSBluetoothPeripheralUsageDescription": "Aetheris uses Bluetooth Peripheral mode to broadcast emergency SOS signals to nearby devices.",
        "NSLocationWhenInUseUsageDescription": "Aetheris requires location access to pinpoint exact GPS coordinates of victims during disaster extraction."
      }
    },
    "android": {
      "package": "com.aetheris.mesh",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#090d16"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "e0ee13b5-eaa7-4294-a06a-795a64070f09"
      }
    }
  }
}
