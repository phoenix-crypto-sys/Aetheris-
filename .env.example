# ==============================================================================
# Aetheris Mesh Environment Configuration Template
# Copy this file to .env (or configure in your deployment platform)
# ==============================================================================

# --- Frontend / Next.js Dashboard Configuration ---
# Public URL of the FastAPI backend routing engine
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-side backend URL (if different from public client URL)
BACKEND_API_URL=http://localhost:8000

# --- FastAPI Backend Routing Engine Configuration ---
# CORS Allowed Origins (comma-separated list, or * for open dev access)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Port (assigned dynamically by Render/Heroku/Railway in production)
PORT=8000

# Rate Limiting (per 16-bit sender_hash)
AETHERIS_RATE_LIMIT_MAX_PACKETS=10
AETHERIS_RATE_LIMIT_WINDOW_SECS=5.0

# Layer 3: Poincaré Hyperbolic Routing Parameters
# Reference scale in meters for mapping local coordinates into unit disk
AETHERIS_HYPERBOLIC_SCALE_R=200.0

# Layer 3: Ant Colony Optimization (ACO) Scoring Parameters
# Pheromone exponential decay rate per second (0.005 => t_half ~ 138.6s)
AETHERIS_ACO_LAMBDA=0.005

# Multi-Objective Scoring Weights (must sum to 1.0)
AETHERIS_ACO_ALPHA=0.35
AETHERIS_ACO_BETA=0.35
AETHERIS_ACO_GAMMA=0.15
AETHERIS_ACO_DELTA=0.15

# --- Optional Mobile Client Configuration ---
EXPO_PUBLIC_API_URL=http://localhost:8000
